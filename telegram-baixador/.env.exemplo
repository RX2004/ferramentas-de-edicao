# Copie este arquivo para ".env" (na mesma pasta) e preencha com as SUAS credenciais.
# Crie em https://my.telegram.org -> API development tools. Nunca publique o .env.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=cole_sua_api_hash_aqui

# Opcional:
# TELEGRAM_PASTA_DOWNLOAD=C:/caminho/para/salvar
# TELEGRAM_SESSAO=baixador_por_hashtag
